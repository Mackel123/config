	match app-id=r#"^io\.github\.amit9838\.mousam$"#
	match app-id=r#"^org\.zathura\.Zathura$"#
	match app-id="nwg-look$"
	match app-id="pcmanfm-qt$"
	match app-id="kitty$"
	match app-id=r#"org\.telegram\.desktop$"#
	match app-id="qt6ct"
	match app-id="qt5ct"
	match app-id="kvantummanager"
	match app-id="YACReader$"
	match app-id="kitty$"
	match app-id=r#"^org\.mozilla\.Thunderbird$"#
	match app-id="^mpv$"
