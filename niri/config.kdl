//windows-effect
//opacity
window-rule { 
	match app-id="code$"	
	match app-id="zen$"	
//	match app-id="google-chrome$"	
	match app-id="kitty$"
	match app-id=r#"^org\.localsend\.localsend_app$"#
	match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
	match app-id=r#"org\.qbittorrent\.qBittorrent$"#
	match app-id="firefox$"
	match app-id="helium$"
	match app-id="Spotify$"
	match app-id="fooyin$"
	match app-id="vesktop$"
	match app-id="pcmanfm-qt"
	match app-id="YACReader$"
	match app-id="discord$"
	match app-id="qutebrowser$"
	match app-id=r#"^org\.pwmt\.zathura$"#
	match app-id=r#"^com\.vysp3r\.ProtonPlus$"#
  match app-id=r#"^fr\.handbrake\.ghb$"#	
  match app-id=r#"^com\.github\.johnfactotum\.Foliate$"#
  match app-id=r#"^info\.febvre\.Komikku$"#	
	match app-id=r#"org\.telegram\.desktop$"#
	match app-id=r#"^io\.github\.xiaoyifang\.goldendict_ng$"#
	match app-id=r#"^org\.mozilla\.Thunderbird$"#
	draw-border-with-background false
	opacity 0.8
}

//opacity for Nautilus
window-rule {
	match app-id=r#"^org\.gnome\.Nautilus$"#
	opacity 0.6
	draw-border-with-background false
}
//fix wezterm
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {fixed 960; }
	  open-floating true
		opacity 0.9
}
//block-screenshot
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screencast"
}
//radius-corner
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
//vsfetch-rule
window-rule {
    match app-id="vsfetch$"
    open-floating true
    opacity 0.5
}

//blur
blur {
	passes 4
	offset 3
	noise 0.25
	saturation 0.2
}
window-rule {
	background-effect {
		xray false
		blur true
	}
}
//lx-music-desktop floating
window-rule {
	match app-id="^lx-music-desktop$"
	open-floating true
	shadow {
	   off
  }
	opacity 0.6
	draw-border-with-background false
	background-effect {
		xray false
		blur true
	}
}
//steam-fullscreen
window-rule {
	match app-id="steam_app_0"
	match app-id="steam$"
//    open-maximized true
//    open-maximized-to-edges true
//    open-fullscreen true
    open-floating true
    open-focused false
		draw-border-with-background false
		opacity 0.6

}


layer-rule {
	match namespace="^rofi$"
	opacity 0.7
	background-effect {
		blur true
		xray true
	}
}
layer-rule {
	match namespace="^waybar$"
	background-effect {
	  blur true
	}
	popups {
		background-effect {
			blur true
		}
	}
}

layer-rule {
	match namespace="^notifications$"
	opacity 0.9
	block-out-from "screen-capture"
}
//firefox-pip
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 540; }
}
//vesktop
window-rule {
	match app-id="vesktop$"
	open-floating true
	shadow {
	   on
  }
	focus-ring {
		on
	}
}

//spotify-mini-player
window-rule {
	match app-id="Chromium-browser$"
	
	default-window-height { fixed 392; }
	default-column-width { fixed 272; }
	open-floating true
  open-focused false
	opacity 0.5
	draw-border-with-background false
	focus-ring {
		off
	}

}
//open-but-not-focus
window-rule {
	match app-id=r#"^org\.localsend\.localsend_app$"#
	match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
	open-focused false
}
//use red color to indicate the window is recording
// 用红色标示正在录制的窗口。
window-rule {
    match is-window-cast-target=true

//    focus-ring {
//        active-color "#f38ba8"
//        inactive-color "#7d0d2d"
//    }
//
//    border {
//        inactive-color "#7d0d2d"
//    }
//
//    shadow {
//        color "#7d0d2d70"
//    }
//
//    tab-indicator {
//        active-color "#f38ba8"
//        inactive-color "#7d0d2d"
//    }
}

//keybind-map
binds {
    //system application hotkey
	  Mod+Shift+Slash                                                      { "show-hotkey-overlay"; }
    Mod+Return       hotkey-overlay-title="Open a Terminal: kitty"       { spawn "kitty"; }
    ALT+Space        hotkey-overlay-title="Run an Application: rofi"     { spawn "~/.config/rofi/bin/launcher.sh"; }
    Mod+L            hotkey-overlay-title="Lock the Screen: swaylock"    { spawn "swaylock-fancy" "-p"; }
    //wallpaper hotkey
		CTRL+SHIFT+W     hotkey-overlay-title="Change Wallpaper"             { spawn-sh "qs -n -p ~/.config/quickshell/niriquickpaper/"; }
		//Audio
		XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    //Media
		XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    //Screenshot
		Print                hotkey-overlay-title="ScreenPrint"             { screenshot; }
    Ctrl+Print           hotkey-overlay-title="FullscreenPrint"         { screenshot-screen; }
    Alt+Print            hotkey-overlay-title="windowsScreenPrint"      { screenshot-window; }
    //colorpicker
		Mod+P { spawn-sh "niri msg pick-color | wl-copy"; }
		//Ovieview
		ALT+Tab repeat=false { toggle-overview; }
	  //mako mode toggle
		ALT+N { spawn-sh "~/.config/niri/scripts/toggle-mako-mode.sh"; }
		//Focus move
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    //Move position
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
		//focus and move window
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }
    //focus and move column
		Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    //move workspace
		Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
 		//Move column to workspace
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; } 
		//wheel scroll 
		Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; } 
		Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; } 
		//workspace 
    Mod+1 { focus-workspace 1; } 
		Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }    
		Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    // Switches focus between the current and the previous workspace.
    Mod+Shift+Escape { focus-workspace-previous; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }

    //window size
    Mod+S { switch-preset-column-width; }
    Mod+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+ALT+F { maximize-window-to-edges; }
		//change window size
		Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }
    //Floating toggle
		Mod+Space       { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }
    Mod+C repeat=false { close-window; }
    Mod+W { toggle-column-tabbed-display; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Q { quit; }
    Mod+Shift+P { power-off-monitors; }

		//rofi
		Mod+M hotkey-overlay-title="rofi-mpd-menu"       { spawn "~/.config/rofi/bin/mpd.sh"; }
		Mod+X hotkey-overlay-title="rofi-powermenu"      { spawn "~/.config/rofi/bin/powermenu.sh"; }
    Mod+G hotkey-overlay-title="rofi-clipboard"      { spawn "~/.config/niri/scripts/clip.sh"; }
		Mod+N hotkey-overlay-title="rofi-networkmanager" { spawn "networkmanager_dmenu"; }
		Mod+D hotkey-overlay-title="rofi-screenshot"     { spawn "~/.config/rofi/bin/screenshot.sh"; }
		//TUI application
		CTRL+ALT+A hotkey-overlay-title="launch nvtop"    { spawn "kitty" "-e" "nvtop"; }
    CTRL+ALT+B hotkey-overlay-title="launch btop"     { spawn "kitty" "-e" "btop"; }
    CTRL+ALT+D hotkey-overlay-title="launch dgop"     { spawn "kitty" "-e" "dgop"; }
		CTRL+ALT+G hotkey-overlay-title="launch ncmpcpp"  { spawn "kitty" "-e" "ncmpcpp"; }
		CTRL+ALT+H hotkey-overlay-title="launch htop"     { spawn "kitty" "-e" "htop"; }
