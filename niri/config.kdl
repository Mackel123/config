	match app-id=r#"^com\.github\.johnfactotum\.Foliate$"#
	match app-id=r#"^org\.pwmt\.zathura$"#
	match app-id="venera$"
	match app-id="nm-connection-editor$"
	match app-id="lxtask$"
	match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
	match app-id=r#"^com\.github\.wwmm\.easyeffects$"#
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.musicbrainz\.Picard$"#
  match app-id=r#"^org\.gnome\.Nautilus$"#
  match app-id=r#"^net\.lutris\.Lutris$"#
  match app-id=r#"^app\.drey\.EarTag$"#	
  match app-id=r#"^moe\.tsuna\.tsukimi$"#	
  match app-id=r#"^info\.febvre\.Komikku$"#	
