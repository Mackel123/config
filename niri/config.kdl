// This config is in the KDL format: https://kdl.dev
// comments out the following node.
// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction

// Input device configuration.
// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
          layout "us"
        }
        numlock
    }
    mouse {
        natural-scroll
        accel-speed 1
        accel-profile "flat"
        scroll-method "edge"
				scroll-button 273
        middle-emulation
    }
}
        // left-handed
        // middle-emulation        
				// scroll-button 273
        // scroll-button-lock
        // left-handed
        // middle-emulationo uncomment the node by removing "/-"!
output "HDMI-A-1" {
    // Uncomment this line to disable this output.
    // off
    mode "3840x2160@60.000"
    scale 1.1
    transform "normal"
    position x=1920 y=0
}
//environment
environment {
	QT_QPA_PLATFORMTHEME "qt6ct"
	QT_AUTO_SCREEN_SCALE_FACTOR "1"
	TERMINAL "kitty"
	EDITOR "vim"
	BROWSER "helium"
	FILEMANAGER "pcmanfm-qt"
	PLAYERCTL_IGNORE_PLAYER "chromium*,firefox,io.github.mpc_qt.mpc-qt$,vlc,mpv,MpcQt"
}

//cursor
cursor {
	xcursor-theme "Layan-cursors"
	xcursor-size 24
	hide-when-typing true
	hide-after-inactive-ms 1000
}

//layout
layout {
    gaps 15
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-gradient from="#5e81ac" to="#eceff4" angle=45 
			  inactive-gradient from="#4c566a" to="#2e3440" angle=45 relative-to="workspace-view" 
		}
		border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"  
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#d8dee9" to="#2e3440" angle=45 relative-to="workspace-view"
    }
    shadow {
        on
        draw-behind-window true
        softness 7
        spread 3
        offset x=0 y=4
        color "#0007"
    }
    struts {
        left 10
        right 10
        top 10
        bottom 5
    }
//	background-color "transparent"
}
//overview
//overview-wallpaper
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
		background-effect {
			blur true
		}
		opacity 0.6
}
overview {
    workspace-shadow {
        on
    }
		zoom 0.4
		backdrop-color "#000B0D20"
}
//windows-swicher
recent-windows {
	debounce-ms 750
	open-delay-ms 150
	highlight {
//		active-color "#5e81ac"
//		urgent-color "#2e3440"
		padding 30
		corner-radius 3
	}
	previews {
		max-height 600
		max-scale 0.5
	}
}
// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

//animations
include "niri-animation-collection/animations/dither-glitch.kdl"
animations {
    on
		workspace-switch {
		  spring damping-ratio=0.7 stiffness=500 epsilon=0.001
		}
//		window-open {
//      duration-ms 150
//			curve "ease-out-expo"
//		}
//		window-close {
//			duration-ms 150
//			curve "ease-out-quad"
//		}
		horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
		window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

//workspace-rule
workspace "terminal"
workspace "browser"
workspace "filemanager"
workspace "code"
workspace "media"
workspace "editor"
workspace "chat"
workspace "book"
workspace "systemsettings"

window-rule {
	match app-id="kitty$"
	open-on-workspace "terminal"
}
window-rule {
	match app-id="firefox$"
	match app-id="qutebrowser$"
	match app-id="google-chrome$"	
	match app-id=r#"org\.qbittorrent\.qBittorrent$"#
	match app-id="helium$"
	match app-id=r#"^org\.mozilla\.Thunderbird$"#
	match app-id=r#"^io\.github\.amit9838\.mousam$"#
	open-on-workspace "browser"
}
window-rule {
	match app-id="pcmanfm-qt$"
	open-on-workspace "filemanager"
}
window-rule {
	match app-id="code$"	
	match app-id=r#"^org\.libreoffice\.LibreOffice$"#
	match app-id="libreoffice-writer$"
	match app-id="libreoffice-startcenter$"
	match app-id="libreoffice-impress$"
	match app-id="libreoffice-calc$"
	match app-id="libreoffice-draw$"
	match app-id="libreoffice-base$"
	open-on-workspace "code"
}
window-rule {
	match app-id="mpv$"
	match app-id=r#"io.github.mpc_qt.mpc-qt$"#
  match app-id=r#"^moe\.tsuna\.tsukimi$"#	
	match app-id="Spotify$"
	match app-id="^lx-music-desktop$"
	match app-id="^FeelUOwn$"
	match app-id="fooyin$"
	open-on-workspace "media"
}
window-rule {
	match app-id="inkscape$"
	match app-id="krita$"
	match app-id="kdenlive$"
	match app-id="blender$"
	match app-id="gimp$"
	match app-id="Audacity$"
	match app-id="darktable$"
	match app-id="resolve$"
	match app-id="OpenToonz$"
	match app-id=r#"fr.handbrake.ghb$"#
	match app-id=r#"^io\.github\.xiaoyifang\.goldendict_ng$"#
	open-on-workspace "editor"
}
window-rule {
	match app-id="discord$"
	match app-id="vesktop$"
	match app-id=r#"org\.telegram\.desktop$"#
  match app-id=r#"^net\.lutris\.Lutris$"#
  match app-id="^wechat$"
  match app-id="^QQ$"
	open-on-workspace "chat"
}
window-rule {
	match app-id="foliate$"
	match app-id=r#"^org\.zathura\.Zathura$"#
	match app-id=r#"^com\.github\.johnfactotum\.Foliate$"#
	match app-id=r#"^info\.febvre\.Komikku$"#
	match app-id="YACReaderLibrary$"
	match app-id="calibre-gui$"
	match app-id="steam$"
  match app-id=r#"^com\.vysp3r\.ProtonPlus$"#	
	open-on-workspace "book"
}
window-rule {
	match app-id="nwg-look"
	match app-id="qt6ct"
	match app-id="qt5ct"
	match app-id=r#"^org\.localsend\.localsend_app$"#
	match app-id="kvantummanager"
	match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
	match app-id=r#"^com\.github\.wwmm\.easyeffects$"#
	match app-id=r#"^com\.obsproject\.Studio"#
	match app-id="vsfetch$"
	open-on-workspace "systemsettings"
}

//wadowrule-app
