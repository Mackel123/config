/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                          "~/.config/rofi/share/color.rasi"
@import                          "~/.config/rofi/share/font.rasi"

/*
USE_ICON=YES
*/

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;
    margin:                      0px;
    padding:                     0px;
    border:                      5px solid;
    border-radius:               0px;
    border-color:                @primary;
    cursor:                      "default";
    background-color:            @surface;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     15px;
    background-color:            transparent;
    children:                    ["inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @primary-fixed;
    background-color:            transparent;
    text-color:                  @primary;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ";
    padding:                     10px 10px;
    border-radius:               0px;
    background-color:            @surface-bright;
    text-color:                  @on-primary;
}
prompt {
    enabled:                     true;
    padding:                     10px;
    border-radius:               0px;
    background-color:            @on-primary-fixed;
    text-color:                  @inverse-primary;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    scrollbar:                   false;
    layout:                      vertical;
    
    spacing:                     20px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     20px 10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @primary-fixed-dim;
    background-color:            transparent;
    text-color:                  @primary-fixed;
    cursor:                      pointer;
}
element-text {
    font:                        "feather 24";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element normal.normal,
element alternate.normal {
    background-color:            var(surface);
    text-color:                  var(primary);
}
element normal.urgent,
element alternate.urgent,
element selected.active {
    background-color:            var(surface-bright);
    text-color:                  var(primary);
}
element normal.active,
element alternate.active,
element selected.urgent {
    background-color:            var(surface-dim);
    text-color:                  var(primary);
}
element selected.normal {
    background-color:            var(primary-fixed);
    text-color:                  var(surface-dim);
}
